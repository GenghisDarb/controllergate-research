+#!/usr/bin/env python3
+"""Validate the dry-run metadata manifest for ControllerGate Episode 002."""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+
+REQUIRED_FIELDS = ["project_name", "version", "required_files", "validators"]
+
+
+def emit_failure(signature: str, detail: str) -> int:
+    print("metadata manifest validation failed")
+    print(signature)
+    print(detail)
+    return 1
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 2:
+        return emit_failure(
+            "USAGE_ERROR",
+            "expected: python tools/validate_metadata_manifest.py metadata_manifest.json",
+        )
+
+    manifest_path = Path(argv[1])
+    if not manifest_path.exists():
+        return emit_failure("MANIFEST_FILE_MISSING", f"path: {manifest_path}")
+
+    try:
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    except json.JSONDecodeError as exc:
+        return emit_failure("MANIFEST_JSON_INVALID", f"{exc.msg} at line {exc.lineno}, column {exc.colno}")
+
+    if not isinstance(manifest, dict):
+        return emit_failure("MANIFEST_SHAPE_INVALID", "metadata_manifest.json must contain a JSON object")
+
+    for field in REQUIRED_FIELDS:
+        if field not in manifest:
+            return emit_failure(f"MISSING_REQUIRED_FIELD: {field}", f"metadata_manifest.json lacks {field!r}")
+
+    if not isinstance(manifest["version"], str):
+        actual_type = type(manifest["version"]).__name__
+        return emit_failure("TYPE_MISMATCH: version", f"version must be a string, got {actual_type}")
+
+    required_files = manifest["required_files"]
+    if not isinstance(required_files, list) or not all(isinstance(item, str) for item in required_files):
+        return emit_failure("REQUIRED_FILES_SHAPE_INVALID", "required_files must be a list of strings")
+
+    missing_files = [item for item in required_files if not Path(item).exists()]
+    if missing_files:
+        return emit_failure("REQUIRED_FILE_NOT_FOUND", f"missing: {', '.join(missing_files)}")
+
+    validators = manifest["validators"]
+    if not isinstance(validators, list) or not validators:
+        return emit_failure("VALIDATORS_SHAPE_INVALID", "validators must be a non-empty list")
+
+    print("metadata manifest validation passed")
+    print(f"required_files_checked: {len(required_files)}")
+    print(f"validators_declared: {len(validators)}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
