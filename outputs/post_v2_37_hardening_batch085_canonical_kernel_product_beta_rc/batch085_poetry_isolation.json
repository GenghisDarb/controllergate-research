{
  "direct_process_replays_under_verified_policy": 0,
  "launcher_failure_used_as_source_evidence": false,
  "network_policy": {
    "assurance_level": "APPLICATION_SOCKET_DENIAL_WITH_CHILD_AUDIT",
    "command_network_independent": true,
    "environment_marker_only": false,
    "external_socket_canary_required": true,
    "network_capable_child_process_allowed": false,
    "platform": "posix",
    "policy_frozen_before_execution": true,
    "socket_denial": true,
    "status": "PASS",
    "subprocess_tree_audit_required": true
  },
  "powershell_invocation": [
    "pwsh",
    "-NoProfile",
    "-Command",
    "& $args[0] $args[1] $args[2]",
    "poetry",
    "init",
    "-n"
  ],
  "source_ownership": "NOT_ESTABLISHED",
  "status": "BOUNDARY_REGRESSION_PASS"
}
