{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controllergate://schemas/candidate-execution-contract-v2",
  "additionalProperties": false,
  "properties": {
    "acquisition_network_policy": {"type": "string"},
    "adversarial_controls": {"type": "array"},
    "candidate_class": {"type": "string"},
    "candidate_id": {"type": "string"},
    "contract_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "environment_allowlist": {"items": {"type": "string"}, "type": "array"},
    "execution_network_policy": {"enum": ["none", "loopback_only"]},
    "negative_controls": {"type": "array"},
    "parser_id": {"type": "string"},
    "positive_controls": {"type": "array"},
    "project_build_source": {"type": "string"},
    "additional_project_install_paths": {"items": {"type": "string"}, "type": "array"},
    "project_build_argv": {"items": {"type": "string"}, "type": "array"},
    "provider_install_specs": {"items": {"type": "string"}, "type": "array"},
    "provider_python": {"type": "string"},
    "repository": {"pattern": "^https://github.com/", "type": "string"},
    "resource_budget": {"type": "object"},
    "secondary_source": {"type": ["object", "null"]},
    "source_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "source_path_classes": {"type": "object"},
    "target_argv": {"items": {"type": "string"}, "type": "array"},
    "target_environment": {"type": "object"},
    "target_paths": {"items": {"type": "string"}, "type": "array"},
    "target_working_compartment": {"enum": ["EXECUTION_WORKSPACE", "CONSUMER_OR_TARGET_WORKSPACE"]},
    "truth_or_outcome_fields_present": {"const": false},
    "authority_allowed": {"type": "string"},
    "authority_forbidden": {"items": {"type": "string"}, "type": "array"},
    "verifier_id": {"type": "string"}
  },
  "required": [
    "candidate_id", "repository", "source_commit", "candidate_class", "provider_python",
    "provider_install_specs", "project_build_source", "additional_project_install_paths", "project_build_argv", "target_argv", "target_paths",
    "target_working_compartment", "target_environment", "parser_id", "verifier_id",
    "positive_controls", "negative_controls", "adversarial_controls", "acquisition_network_policy",
    "execution_network_policy", "environment_allowlist", "resource_budget", "source_path_classes", "secondary_source"
  ],
  "title": "CandidateExecutionContractV2",
  "type": "object"
}
