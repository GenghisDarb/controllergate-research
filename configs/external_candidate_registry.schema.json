{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControllerGate External Candidate Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_policy",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "v2.25"
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_manual_review",
        "requires_buggy_commit_tree_test_presence",
        "requires_expected_failure_log_hash",
        "forbids_fixed_future_gold_synthetic_tests"
      ],
      "properties": {
        "requires_manual_review": {
          "const": true
        },
        "requires_buggy_commit_tree_test_presence": {
          "const": true
        },
        "requires_expected_failure_log_hash": {
          "const": true
        },
        "forbids_fixed_future_gold_synthetic_tests": {
          "const": true
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "candidate_id",
        "source_type",
        "repo_url",
        "buggy_commit_sha",
        "test_command",
        "expected_failure_signature",
        "target_test_files",
        "environment_lock_source",
        "decision_time_safe_basis",
        "registry_author",
        "registry_review_status",
        "created_utc",
        "notes"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "public_github_repo",
            "public_git_repo"
          ]
        },
        "repo_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "buggy_commit_sha": {
          "$ref": "#/$defs/sha1"
        },
        "test_command": {
          "type": "string",
          "minLength": 1
        },
        "expected_failure_signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "log_hash",
            "exception_type",
            "failing_file",
            "failure_text_excerpt_hash",
            "normalization_policy"
          ],
          "properties": {
            "log_hash": {
              "$ref": "#/$defs/sha256"
            },
            "exception_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "failing_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "failure_text_excerpt_hash": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "normalization_policy": {
              "const": "strip_timestamps_absolute_paths_ansi_venv_prefixes"
            }
          }
        },
        "target_test_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "support_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "support_file_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment_lock_source": {
          "type": "string",
          "minLength": 1
        },
        "decision_time_safe_basis": {
          "type": "string",
          "enum": [
            "offline_manual_verification",
            "public_ci_logs",
            "public_ci_logs_plus_local_reproduction",
            "public_issue_tracker_documentation_plus_local_reproduction"
          ]
        },
        "registry_author": {
          "type": "string",
          "minLength": 1
        },
        "registry_review_status": {
          "const": "reviewed"
        },
        "created_utc": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
