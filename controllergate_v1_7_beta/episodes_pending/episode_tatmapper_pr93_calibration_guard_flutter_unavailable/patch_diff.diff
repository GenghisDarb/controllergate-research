+#!/usr/bin/env bash
+set -euo pipefail
+
+placeholder_matches="$(git grep -nE '\\b10(\\.0+)?\\b' -- app/lib || true)"
+if [[ -n "${placeholder_matches}" ]]; then
+  filtered_matches="$(printf '%s\n' "${placeholder_matches}" | grep -i 'px.*mm' || true)"
+  if [[ -n "${filtered_matches}" ]]; then
+    echo "ERROR: Found forbidden 10 px/mm placeholder usage in Dart sources:" >&2
+    echo "${filtered_matches}" >&2
+    exit 1
+  fi
+fi
+
+echo "Guard checks passed."

