{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controllergate.local/schemas/v1_7_alpha_episode.schema.json",
  "title": "ControllerGate v1.7-alpha Real Trace Episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "source_type",
    "repo",
    "repo_commit",
    "branch",
    "decision_time",
    "failure_type",
    "visible_failure",
    "failing_command",
    "failure_log",
    "patch_attempted",
    "patch_diff",
    "files_read",
    "files_written",
    "agent_trace",
    "visible_tests_passed",
    "downstream_failed_later",
    "agent_claim",
    "claim_matched_reality",
    "stale_read_detected",
    "dependency_or_config_drift",
    "generated_artifact_mismatch",
    "available_at_decision_time",
    "prohibited_future_fields",
    "evidence_status",
    "source_episode_folder",
    "artifact_package_path",
    "artifact_notebook_path",
    "fixture_artifact_path",
    "packaged_pass_count",
    "packaged_total_count",
    "rerun_pass_count",
    "rerun_total_count",
    "sha_manifest_verified",
    "sha_mismatch_count",
    "runner_completed",
    "analyzer_completed",
    "builder_claim",
    "verified_result",
    "claim_matched_verified_result",
    "failure_or_success_type",
    "decision_time_evidence_available",
    "outcome_only_evidence",
    "future_leakage_risk",
    "stale_read_or_false_completion_detected",
    "generated_artifact_mismatch_detected",
    "dependency_or_config_drift_detected",
    "correction_required",
    "human_critic_required",
    "hidden_or_downstream_truth_source",
    "memory_lesson",
    "caveat",
    "normalized_status"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^episode_[0-9]{3,}$"
    },
    "source_type": {
      "type": "string",
      "enum": ["real_repo", "real_agent_trace", "controlled_benchmark", "unavailable"]
    },
    "category": {
      "type": ["string", "null"],
      "enum": [
        "correction_review_episode",
        "controlled_benchmark_evidence",
        "external_real_repo_episode",
        "excluded_from_scoring",
        null
      ]
    },
    "source_repo": {
      "type": ["string", "null"]
    },
    "source_pr": {
      "type": ["integer", "null"]
    },
    "outcome_type": {
      "type": ["string", "null"]
    },
    "failure_reason": {
      "type": ["string", "null"]
    },
    "positive_signal": {
      "type": ["string", "null"]
    },
    "pr_status": {
      "type": ["string", "null"]
    },
    "scoring_allowed_for_v1_7_alpha_real_repo_claim": {
      "type": ["boolean", "string"]
    },
    "evidence_status_detail": {
      "type": ["string", "null"]
    },
    "github_actions_log_status": {
      "type": ["string", "null"]
    },
    "github_actions_rerun_status": {
      "type": ["string", "null"]
    },
    "local_clone_path": {
      "type": ["string", "null"]
    },
    "rerun_command": {
      "type": ["string", "null"]
    },
    "repo": {
      "type": "string"
    },
    "repo_commit": {
      "type": ["string", "null"]
    },
    "branch": {
      "type": ["string", "null"]
    },
    "decision_time": {
      "type": ["string", "null"],
      "description": "ISO-8601 timestamp, or null if unavailable."
    },
    "failure_type": {
      "type": "string"
    },
    "visible_failure": {
      "type": ["string", "null"]
    },
    "failing_command": {
      "type": ["string", "null"]
    },
    "failure_log": {
      "type": ["string", "null"]
    },
    "patch_attempted": {
      "type": "boolean"
    },
    "patch_diff": {
      "type": ["string", "null"]
    },
    "files_read": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_written": {
      "type": "array",
      "items": { "type": "string" }
    },
    "agent_trace": {
      "type": ["string", "null"]
    },
    "visible_tests_passed": {
      "type": ["boolean", "null"]
    },
    "downstream_failed_later": {
      "type": ["boolean", "null"]
    },
    "agent_claim": {
      "type": ["string", "null"]
    },
    "claim_matched_reality": {
      "type": ["boolean", "null"]
    },
    "stale_read_detected": {
      "type": ["boolean", "null"]
    },
    "dependency_or_config_drift": {
      "type": ["boolean", "null"]
    },
    "generated_artifact_mismatch": {
      "type": ["boolean", "null"]
    },
    "memory_keys": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Evidence-derived keys only; no final labels or future outcomes."
    },
    "available_at_decision_time": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prohibited_future_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_status": {
      "type": "string",
      "enum": ["complete", "partial", "unavailable"]
    },
    "unavailable_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_episode_folder": {
      "type": "string"
    },
    "artifact_package_path": {
      "type": ["string", "null"]
    },
    "artifact_notebook_path": {
      "type": ["string", "null"]
    },
    "fixture_artifact_path": {
      "type": ["string", "null"]
    },
    "packaged_pass_count": {
      "type": ["integer", "null"]
    },
    "packaged_total_count": {
      "type": ["integer", "null"]
    },
    "rerun_pass_count": {
      "type": ["integer", "null"]
    },
    "rerun_total_count": {
      "type": ["integer", "null"]
    },
    "sha_manifest_verified": {
      "type": "boolean"
    },
    "sha_mismatch_count": {
      "type": ["integer", "null"]
    },
    "runner_completed": {
      "type": "boolean"
    },
    "analyzer_completed": {
      "type": "boolean"
    },
    "builder_claim": {
      "type": ["string", "null"]
    },
    "verified_result": {
      "type": "string"
    },
    "claim_matched_verified_result": {
      "type": ["boolean", "null"]
    },
    "failure_or_success_type": {
      "type": "string"
    },
    "decision_time_evidence_available": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outcome_only_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "future_leakage_risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "review_required"]
    },
    "stale_read_or_false_completion_detected": {
      "type": ["boolean", "null"]
    },
    "generated_artifact_mismatch_detected": {
      "type": ["boolean", "null"]
    },
    "dependency_or_config_drift_detected": {
      "type": ["boolean", "null"]
    },
    "correction_required": {
      "type": "boolean"
    },
    "human_critic_required": {
      "type": "boolean"
    },
    "hidden_or_downstream_truth_source": {
      "type": "string"
    },
    "memory_lesson": {
      "type": "string"
    },
    "caveat": {
      "type": ["string", "null"]
    },
    "normalized_status": {
      "type": "string",
      "enum": ["complete", "review_required", "incomplete"]
    }
  }
}
